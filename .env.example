# ============================================================================
# .env.example — copy to .env and fill in. NEVER commit the real .env.
# ============================================================================
# The .env file itself is git-ignored; this example is safe to track because
# it only ever holds placeholders.

# --- Archil persistent workspace -------------------------------------------
# Archil gives the agent a persistent, shared filesystem: files survive between
# runs and are shared across sandboxes. Used by scripts/archil.sh.
#
# Create an API key here, then paste it into your local .env (not this file):
#   https://console.archil.com/welcome

# Archil API key. Required. Read from the environment, never hardcoded.
ARCHIL_API_KEY=

# Region closest to your compute. `exec` is AWS-only today.
#   aws-us-east-1 | aws-us-west-2 | aws-eu-west-1
ARCHIL_REGION=aws-us-east-1

# Optional namespace for per-job working directories under /mnt/data/jobs/.
# exec mounts the disk in shared mode, so each job writes into its own
# subdirectory to avoid "Read-only file system" errors on other clients' trees.
ARCHIL_JOB=default
